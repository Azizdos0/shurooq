---
export const prerender = false; // server-rendered internal tool

import '../styles/global.css';
import Ornament from '../components/Ornament.astro';
import { sections } from '../data/sections.js';
import { TAGS, TAG_LABELS } from '../lib/editor-constants.js';
import { isConfigured } from '../lib/supabase.js';

const configured = isConfigured();
const ordinals = ['الأول', 'الثاني', 'الثالث', 'الرابع', 'الخامس'];

const clientData = {
  sections: sections.map((s, i) => ({
    id: s.id, title: s.title, english: s.english, tagline: s.tagline, ordinal: ordinals[i],
  })),
  tags: TAGS,
  tagLabels: TAG_LABELS,
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>محرّر شروق — داخلي</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Lateef:wght@400;500;600;700&family=EB+Garamond:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="editor-body">
    {!configured && (
      <div class="config-warn">
        قاعدة البيانات غير مهيّأة بعد. ضع مفتاح <code>SUPABASE_SERVICE_ROLE_KEY</code>
        في ملف <code>.env</code> ثم أعد تشغيل الخادم.
      </div>
    )}

    <div class="orn-store" hidden>
      {sections.map((s) => (
        <span data-orn={s.id}><Ornament name={s.ornament} size={72} /></span>
      ))}
    </div>

    <header class="bar">
      <div class="bar-mark">
        <span class="bar-word">شروق</span>
        <span class="bar-tag">محرّر داخلي</span>
      </div>
      <div class="bar-controls">
        <label class="field">
          <span class="field-label">العدد</span>
          <select id="issue-select"></select>
        </label>
        <label class="field">
          <span class="field-label">الباب</span>
          <select id="section-select">
            {clientData.sections.map((s) => <option value={s.id}>{s.title}</option>)}
          </select>
        </label>
      </div>
      <div class="bar-actions">
        <span id="status-note" class="status-note" role="status" aria-live="polite"></span>
        <button id="ready-toggle" class="btn" type="button">وضع «جاهز»</button>
        <button id="save-btn" class="btn btn-accent" type="button">حفظ</button>
      </div>
    </header>

    <main class="editor-grid">
      <section class="pane write-pane" aria-label="الكتابة">
        <div id="template-form" class="tform"></div>

        <div class="sources">
          <div class="sources-head">
            <h2 class="sources-title">سِجِلُّ المصادر</h2>
            <button id="add-source" class="btn btn-small" type="button">+ مصدر</button>
          </div>
          <p class="sources-hint">
            لكلِّ مصدر وسمُ تحقُّق: موثَّق، أو روايةٌ متواترة، أو إعادة تخيُّل. داخليٌّ فقط.
          </p>
          <ul id="sources-list" class="sources-list"></ul>
        </div>
      </section>

      <section class="pane preview-pane" aria-label="المعاينة">
        <div class="preview-label">معاينة — كما ستُنشر</div>
        <article class="preview-doc">
          <hr class="rule-double" />
          <p class="eyebrow">الباب <span data-ordinal></span></p>
          <div class="pv-title-row">
            <span class="pv-orn" data-orn-slot></span>
            <div>
              <h1 class="pv-title" data-title></h1>
              <p class="pv-en" data-en></p>
            </div>
          </div>
          <p class="pv-tagline" data-tagline></p>
          <div class="pv-body" data-body></div>
        </article>
      </section>
    </main>

    <script type="application/json" id="editor-data" set:html={JSON.stringify(clientData)}></script>
    <script>
      import { templates, renderPieceBody } from '../lib/templates.js';

      const data = JSON.parse(document.getElementById('editor-data').textContent);
      const SECTIONS = new Map(data.sections.map((s) => [s.id, s]));

      const el = {
        issue: document.getElementById('issue-select'),
        section: document.getElementById('section-select'),
        form: document.getElementById('template-form'),
        sourcesList: document.getElementById('sources-list'),
        addSource: document.getElementById('add-source'),
        save: document.getElementById('save-btn'),
        ready: document.getElementById('ready-toggle'),
        status: document.getElementById('status-note'),
        pvOrdinal: document.querySelector('[data-ordinal]'),
        pvOrnSlot: document.querySelector('[data-orn-slot]'),
        pvTitle: document.querySelector('[data-title]'),
        pvEn: document.querySelector('[data-en]'),
        pvTagline: document.querySelector('[data-tagline]'),
        pvBody: document.querySelector('[data-body]'),
      };

      let content = {};            // structured content for the current piece
      let pieceStatus = 'draft';
      let dirty = false, saving = false, saveTimer = null;

      const setStatus = (t, cls = '') => { el.status.textContent = t; el.status.className = 'status-note' + (cls ? ' ' + cls : ''); };
      function markDirty() { dirty = true; setStatus('تغييرات غير محفوظة', 'dirty'); clearTimeout(saveTimer); saveTimer = setTimeout(() => save({ auto: true }), 2500); }
      const clone = (o) => JSON.parse(JSON.stringify(o));

      // ---- dynamic form ----------------------------------------------------
      function emptyItem(field) { const o = {}; for (const s of field.item) o[s.id] = ''; return o; }

      function buildForm() {
        const tmpl = templates[el.section.value];
        el.form.innerHTML = '';
        if (!tmpl) return;
        for (const f of tmpl.fields) el.form.appendChild(buildField(f));
      }

      function buildField(f) {
        const wrap = document.createElement('div');
        wrap.className = 'tfield';

        if (f.type === 'line' || f.type === 'prose') {
          const lab = document.createElement('label');
          lab.className = 'tlabel';
          lab.textContent = f.label + (f.role === 'headline' ? ' ★' : '');
          const input = f.type === 'prose' ? document.createElement('textarea') : document.createElement('input');
          if (f.type === 'line') input.type = 'text';
          input.value = content[f.id] || '';
          input.placeholder = f.type === 'prose' ? 'افصل بين الفقرات بسطرٍ فارغ' : '';
          input.addEventListener('input', () => { content[f.id] = input.value; renderPreview(); markDirty(); });
          lab.appendChild(input);
          wrap.appendChild(lab);
          return wrap;
        }

        // list
        const head = document.createElement('div');
        head.className = 'tlist-head';
        const title = document.createElement('span');
        title.className = 'tlabel-inline';
        title.textContent = f.label;
        const add = document.createElement('button');
        add.type = 'button'; add.className = 'btn btn-small';
        add.textContent = '+ إضافة';
        add.addEventListener('click', () => {
          if (!Array.isArray(content[f.id])) content[f.id] = [];
          content[f.id].push(emptyItem(f));
          buildForm(); renderPreview(); markDirty();
        });
        head.append(title, add);
        wrap.appendChild(head);

        if (!Array.isArray(content[f.id])) content[f.id] = f.seed ? clone(f.seed) : [];
        const list = document.createElement('div');
        list.className = 'tlist';
        content[f.id].forEach((item, i) => list.appendChild(buildItemRow(f, item, i)));
        wrap.appendChild(list);
        return wrap;
      }

      function buildItemRow(f, item, index) {
        const row = document.createElement('div');
        row.className = 'titem';
        for (const sub of f.item) {
          const cell = document.createElement('label');
          cell.className = 'tcell';
          const cl = document.createElement('span'); cl.className = 'tcell-label'; cl.textContent = sub.label;
          const inp = sub.type === 'prose' ? document.createElement('textarea') : document.createElement('input');
          if (sub.type === 'line') inp.type = 'text';
          inp.value = item[sub.id] || '';
          inp.addEventListener('input', () => { item[sub.id] = inp.value; renderPreview(); markDirty(); });
          cell.append(cl, inp);
          row.appendChild(cell);
        }
        const rm = document.createElement('button');
        rm.type = 'button'; rm.className = 'src-remove'; rm.textContent = '×'; rm.title = 'حذف';
        rm.addEventListener('click', () => { content[f.id].splice(index, 1); buildForm(); renderPreview(); markDirty(); });
        row.appendChild(rm);
        return row;
      }

      // ---- preview ---------------------------------------------------------
      function renderPreview() {
        const sec = SECTIONS.get(el.section.value);
        if (!sec) return;
        el.pvOrdinal.textContent = sec.ordinal;
        el.pvEn.textContent = sec.english;
        el.pvTagline.textContent = sec.tagline;
        el.pvTitle.textContent = sec.title; // section identity (content headline lives in the body)
        const orn = document.querySelector('.orn-store [data-orn="' + sec.id + '"]');
        el.pvOrnSlot.innerHTML = orn ? orn.innerHTML : '';
        const html = renderPieceBody(sec.id, content); // values escaped inside
        el.pvBody.innerHTML = html || '<p class="pv-empty">تظهر المعاينة هنا وأنت تملأ الحقول…</p>';
      }

      // ---- sources (unchanged behaviour) -----------------------------------
      function makeSourceRow(src = { note: '', url: '', tag: 'verified' }) {
        const li = document.createElement('li'); li.className = 'source-row';
        const note = document.createElement('textarea'); note.placeholder = 'المصدر أو الوصف'; note.value = src.note || ''; note.addEventListener('input', markDirty);
        const url = document.createElement('input'); url.type = 'url'; url.dir = 'ltr'; url.placeholder = 'رابط (اختياري)'; url.value = src.url || ''; url.addEventListener('input', markDirty);
        const tag = document.createElement('select');
        for (const t of data.tags) { const o = document.createElement('option'); o.value = t; o.textContent = data.tagLabels[t]; if (t === src.tag) o.selected = true; tag.appendChild(o); }
        tag.addEventListener('change', markDirty);
        const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'src-remove'; rm.textContent = '×'; rm.title = 'حذف المصدر';
        rm.addEventListener('click', () => { li.remove(); markDirty(); });
        li.append(note, url, tag, rm);
        li._get = () => ({ note: note.value, url: url.value, tag: tag.value });
        return li;
      }
      const readSources = () => [...el.sourcesList.querySelectorAll('.source-row')].map((li) => li._get());
      function setSources(list) { el.sourcesList.innerHTML = ''; for (const s of list) el.sourcesList.appendChild(makeSourceRow(s)); }

      function reflectStatus() { const r = pieceStatus === 'ready'; el.ready.classList.toggle('is-ready', r); el.ready.textContent = r ? '✓ جاهز — للنشر' : 'وضع «جاهز»'; }

      // ---- load / save -----------------------------------------------------
      async function loadIssues() {
        try {
          const j = await (await fetch('/api/issues')).json();
          if (j.error) throw new Error(j.error);
          el.issue.innerHTML = '';
          for (const it of j.issues) { const o = document.createElement('option'); o.value = it.id; o.textContent = it.title || ('العدد ' + (it.number ?? '')); el.issue.appendChild(o); }
        } catch (e) { setStatus('تعذّر تحميل الأعداد: ' + e.message, 'dirty'); }
      }

      async function loadPiece() {
        if (!el.issue.value) return;
        setStatus('يُحمّل…');
        try {
          const url = '/api/piece?issueId=' + encodeURIComponent(el.issue.value) + '&section=' + encodeURIComponent(el.section.value);
          const j = await (await fetch(url)).json();
          if (j.error) throw new Error(j.error);
          content = (j.piece && j.piece.content) ? j.piece.content : {};
          pieceStatus = j.piece?.status || 'draft';
          setSources(j.sources || []);
          reflectStatus(); buildForm(); renderPreview();
          dirty = false;
          setStatus(j.piece ? 'محفوظ' : 'مسودة جديدة', 'saved');
        } catch (e) { buildForm(); renderPreview(); setStatus('تعذّر التحميل: ' + e.message, 'dirty'); }
      }

      async function save({ auto = false } = {}) {
        if (saving || !el.issue.value) return;
        clearTimeout(saveTimer); saving = true;
        if (!auto) setStatus('يحفظ…');
        try {
          const res = await fetch('/api/piece', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ issueId: el.issue.value, section: el.section.value, content, status: pieceStatus, sources: readSources() }),
          });
          const j = await res.json();
          if (j.error) throw new Error(j.error);
          dirty = false;
          const t = new Date().toLocaleTimeString('ar', { hour: '2-digit', minute: '2-digit' });
          setStatus('محفوظ ' + t, 'saved');
        } catch (e) { setStatus('تعذّر الحفظ: ' + e.message, 'dirty'); }
        finally { saving = false; }
      }

      el.section.addEventListener('change', async () => { renderPreview(); if (dirty) await save(); await loadPiece(); });
      el.issue.addEventListener('change', async () => { if (dirty) await save(); await loadPiece(); });
      el.addSource.addEventListener('click', () => { el.sourcesList.appendChild(makeSourceRow()); markDirty(); });
      el.save.addEventListener('click', () => save());
      el.ready.addEventListener('click', () => { pieceStatus = pieceStatus === 'ready' ? 'draft' : 'ready'; reflectStatus(); markDirty(); save(); });
      window.addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

      (async function init() { await loadIssues(); await loadPiece(); })();
    </script>

    <style>
      .editor-body { min-height: 100vh; display: flex; flex-direction: column; }
      .editor-body::before { display: none; }
      .config-warn { background: var(--oxide); color: var(--paper); padding: 0.7rem 1.2rem; font-family: var(--font-body); }
      .config-warn code { background: rgba(255,255,255,0.18); padding: 0 0.3em; }

      .bar { display: flex; align-items: center; gap: var(--space-m); flex-wrap: wrap; padding: 0.7rem clamp(1rem, 3vw, 2rem); border-bottom: 2px solid var(--ink); background: var(--paper); }
      .bar-mark { display: flex; align-items: baseline; gap: 0.5rem; }
      .bar-word { font-family: var(--font-wordmark); font-size: var(--step-2); line-height: 1; }
      .bar-tag { font-family: var(--font-display); color: var(--oxide); font-size: var(--step--1); }
      .bar-controls { display: flex; gap: var(--space-s); flex-wrap: wrap; }
      .bar-actions { display: flex; align-items: center; gap: var(--space-s); margin-inline-start: auto; }
      .field { display: flex; flex-direction: column; gap: 0.15rem; }
      .field-label { font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-soft); }
      select, input, textarea { font-family: var(--font-body); font-size: var(--step-0); color: var(--ink); background: var(--paper); border: 1.5px solid var(--rule-strong); padding: 0.4em 0.6em; width: 100%; }
      select:focus, input:focus, textarea:focus { outline: none; border-color: var(--oxide); }
      .status-note { font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-faint); }
      .status-note.saved { color: var(--ink-soft); }
      .status-note.dirty { color: var(--oxide); }
      .btn-small { padding: 0.3em 0.8em; font-size: var(--step--1); }
      .btn.is-ready { background: var(--ink); color: var(--paper); }

      .editor-grid { flex: 1; display: grid; grid-template-columns: 1fr 1fr; min-height: 0; }
      .pane { padding: clamp(1.2rem, 3vw, 2.4rem); min-height: 0; overflow-y: auto; }
      .write-pane { border-inline-start: 1px solid var(--rule); display: flex; flex-direction: column; gap: var(--space-l); }

      /* dynamic template form */
      .tform { display: flex; flex-direction: column; gap: var(--space-m); }
      .tfield { display: flex; flex-direction: column; gap: 0.3rem; }
      .tlabel { display: flex; flex-direction: column; gap: 0.25rem; font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-soft); }
      .tlabel textarea { min-height: 6em; resize: vertical; line-height: 1.9; font-size: var(--step-1); }
      .tlabel input { font-size: var(--step-1); }
      .tlist-head { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--rule); padding-top: var(--space-s); }
      .tlabel-inline { font-family: var(--font-display); color: var(--oxide); font-size: var(--step-0); }
      .tlist { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.5rem; }
      .titem { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; border: 1px solid var(--rule); padding: 0.5rem; align-items: start; }
      .tcell { display: flex; flex-direction: column; gap: 0.2rem; }
      .tcell-label { font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-faint); }
      .tcell textarea { min-height: 3em; resize: vertical; }

      .sources { border-top: 1px solid var(--rule); padding-top: var(--space-m); }
      .sources-head { display: flex; align-items: center; justify-content: space-between; }
      .sources-title { font-family: var(--font-display); font-size: var(--step-1); }
      .sources-hint { color: var(--ink-faint); font-size: var(--step--1); margin-top: 0.2rem; }
      .sources-list { list-style: none; padding: 0; margin-top: var(--space-s); display: flex; flex-direction: column; gap: 0.6rem; }
      .source-row { display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 0.5rem; align-items: start; border: 1px solid var(--rule); padding: 0.5rem; }
      .source-row textarea { min-height: 2.6em; resize: vertical; }
      .src-remove { border: 1px solid var(--rule-strong); background: transparent; color: var(--ink-soft); cursor: pointer; padding: 0 0.6em; font-size: var(--step-0); width: auto; }
      .src-remove:hover { border-color: var(--oxide); color: var(--oxide); }
      @media (max-width: 52rem) { .source-row { grid-template-columns: 1fr 1fr; } }

      .preview-pane { background: var(--paper-shade); }
      .preview-label { font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-faint); margin-bottom: var(--space-m); }
      .preview-doc { background: var(--paper); padding: clamp(1.4rem, 3vw, 2.6rem); border: 1px solid var(--rule); }
      .preview-doc .rule-double { margin-bottom: var(--space-m); }
      .pv-title-row { display: flex; align-items: center; gap: var(--space-m); margin-top: var(--space-xs); }
      .pv-title { font-size: var(--step-2); line-height: 1.1; }
      .pv-en { color: var(--ink-faint); font-style: italic; font-family: var(--font-latin); }
      .pv-tagline { font-family: var(--font-display); font-size: var(--step-1); color: var(--ink-soft); margin-top: var(--space-s); }
      .pv-body { margin-top: var(--space-l); }
      .pv-body .pv-empty { color: var(--ink-faint); }

      @media (max-width: 52rem) {
        .editor-grid { grid-template-columns: 1fr; }
        .write-pane { border-inline-start: 0; border-bottom: 2px solid var(--ink); }
      }
    </style>
  </body>
</html>
