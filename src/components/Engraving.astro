---
// Large "newspaper cut" illustrations — vintage engraving style, ink-only,
// matching the small Ornament marks but scaled up into proper scenes.
// These are honestly captioned as illustrative drawings, not artifacts.
const { name, caption, zone, variant, class: className = '' } = Astro.props;
// SVG pattern ids must be unique per instance — the same engraving can appear
// on both the cover and its section page, so a variant keeps ids from colliding.
const uid = variant ? `${name}-${variant}` : name;
---
<figure class={`engraving pub-field ${className}`} data-zone={zone}>
  <div class="engraving-frame">
    <svg viewBox="0 0 480 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={caption}>
      <defs>
        <pattern id={`hatch-${uid}`} width="3.2" height="3.2" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="3.2" stroke="currentColor" stroke-width="0.6" />
        </pattern>
        <pattern id={`hatch2-${uid}`} width="3.2" height="3.2" patternTransform="rotate(-45)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="3.2" stroke="currentColor" stroke-width="0.5" />
        </pattern>
      </defs>

      <rect x="4" y="4" width="472" height="272" fill="none" stroke="currentColor" stroke-width="1.5" />
      <rect x="9" y="9" width="462" height="262" fill="none" stroke="currentColor" stroke-width="0.75" />

      {name === 'lost' && (
        <g stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <!-- sky: stars + crescent -->
          <g fill="currentColor" stroke="none" opacity="0.8">
            <circle cx="80" cy="45" r="1.4" /><circle cx="130" cy="30" r="1.1" />
            <circle cx="360" cy="35" r="1.3" /><circle cx="410" cy="55" r="1.1" />
            <circle cx="290" cy="25" r="1" />
          </g>
          <path d="M400 40 A14 14 0 1 1 400 68 A11 11 0 1 0 400 40 Z" fill="currentColor" stroke="none" opacity="0.85" />

          <!-- distant Baghdad skyline -->
          <g opacity="0.75">
            <path d="M40 175 Q55 150 70 175 Z" />
            <line x1="55" y1="150" x2="55" y2="130" /><line x1="52" y1="132" x2="58" y2="132" />
            <path d="M100 175 Q120 140 140 175 Z" fill={`url(#hatch-${uid})`} />
            <path d="M330 175 Q350 145 370 175 Z" fill={`url(#hatch-${uid})`} />
            <line x1="350" y1="145" x2="350" y2="122" /><line x1="347" y1="124" x2="353" y2="124" />
            <path d="M395 175 Q408 155 420 175 Z" />
          </g>
          <line x1="20" y1="175" x2="460" y2="175" stroke-width="1.3" />
          <rect x="20" y="176" width="440" height="10" fill={`url(#hatch2-${uid})`} stroke="none" opacity="0.5" />

          <!-- two robed figures, one raising an astrolabe -->
          <g transform="translate(175,120)">
            <path d="M0 0 C-14 10 -18 40 -16 60 L16 60 C18 40 14 10 0 0 Z" />
            <circle cx="0" cy="-8" r="7" />
            <path d="M-8 -12 Q0 -20 8 -12" />
            <line x1="0" y1="-2" x2="34" y2="-34" />
            <circle cx="40" cy="-40" r="11" />
            <line x1="30" y1="-40" x2="50" y2="-40" stroke-width="0.6" />
            <line x1="40" y1="-50" x2="40" y2="-30" stroke-width="0.6" />
            <line x1="33" y1="-47" x2="47" y2="-33" stroke-width="0.4" opacity="0.6" />
          </g>
          <g transform="translate(230,128)">
            <path d="M0 0 C-12 9 -15 36 -13 52 L13 52 C15 36 12 9 0 0 Z" />
            <circle cx="0" cy="-7" r="6" />
            <path d="M-7 -10 Q0 -17 7 -10" />
          </g>
          <!-- scroll case at their feet -->
          <rect x="185" y="178" width="26" height="7" rx="3" fill="none" />
        </g>
      )}

      {name === 'people' && (
        <g stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <line x1="20" y1="195" x2="460" y2="195" stroke-width="1.3" />
          <rect x="20" y="196" width="440" height="8" fill={`url(#hatch2-${uid})`} stroke="none" opacity="0.5" />

          <!-- stalls -->
          <g opacity="0.9">
            <path d="M55 140 L100 140 L92 120 L63 120 Z" />
            <line x1="55" y1="140" x2="55" y2="190" /><line x1="100" y1="140" x2="100" y2="190" />
            <line x1="55" y1="168" x2="100" y2="168" />
            <circle cx="65" cy="178" r="4" /><circle cx="75" cy="180" r="4" /><circle cx="85" cy="178" r="3.5" />
          </g>
          <g opacity="0.9">
            <path d="M240 132 L300 132 L290 108 L250 108 Z" fill={`url(#hatch-${uid})`} />
            <line x1="240" y1="132" x2="240" y2="190" /><line x1="300" y1="132" x2="300" y2="190" />
            <line x1="240" y1="162" x2="300" y2="162" />
            <rect x="255" y="150" width="24" height="8" />
          </g>
          <g opacity="0.9">
            <path d="M370 140 L415 140 L407 120 L378 120 Z" />
            <line x1="370" y1="140" x2="370" y2="190" /><line x1="415" y1="140" x2="415" y2="190" />
            <line x1="370" y1="168" x2="415" y2="168" />
            <circle cx="384" cy="178" r="3.5" /><circle cx="394" cy="179" r="3.5" /><circle cx="404" cy="177" r="3" />
          </g>

          <!-- small figures -->
          <g transform="translate(140,150)"><path d="M0 0 C-9 7 -11 28 -10 40 L10 40 C11 28 9 7 0 0 Z" /><circle cx="0" cy="-6" r="5.5" /></g>
          <g transform="translate(200,155)"><path d="M0 0 C-8 6 -9 24 -8 34 L8 34 C9 24 8 6 0 0 Z" /><circle cx="0" cy="-5" r="5" /><circle cx="0" cy="-16" r="4" opacity="0.7" /></g>
          <g transform="translate(335,148)"><path d="M0 0 C-10 8 -12 30 -11 42 L11 42 C12 30 10 8 0 0 Z" /><circle cx="0" cy="-6.5" r="6" /></g>
        </g>
      )}

      {name === 'without' && (
        <g stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M240 250 L240 190" stroke-width="2" />
          <path d="M240 190 C200 150 140 120 90 70" stroke-width="1.6" />
          <path d="M240 190 C280 150 340 120 385 75" stroke-width="1.6" stroke-dasharray="1 7" opacity="0.7" />

          <!-- lit tower / preserved knowledge, at the solid path's end -->
          <g transform="translate(90,70)">
            <g fill="currentColor" stroke="none" opacity="0.15">
              <path d="M0 0 L-30 -10 L-30 -35 L30 -35 L30 -10 Z" />
            </g>
            <path d="M-16 0 L-16 -30 L16 -30 L16 0" />
            <path d="M-20 0 L20 0" stroke-width="1.4" />
            <line x1="-16" y1="-30" x2="0" y2="-46" /><line x1="16" y1="-30" x2="0" y2="-46" />
            <circle cx="0" cy="-52" r="4" fill="currentColor" stroke="none" />
            <g stroke-width="0.6" opacity="0.7">
              <line x1="0" y1="-52" x2="0" y2="-66" /><line x1="-10" y1="-46" x2="-20" y2="-54" />
              <line x1="10" y1="-46" x2="20" y2="-54" /><line x1="-11" y1="-58" x2="-19" y2="-64" />
              <line x1="11" y1="-58" x2="19" y2="-64" />
            </g>
          </g>

          <!-- fading path's end: scattering, unfinished -->
          <g transform="translate(385,75)" opacity="0.6">
            <circle cx="0" cy="0" r="1.6" fill="currentColor" stroke="none" />
            <circle cx="10" cy="-8" r="1.2" fill="currentColor" stroke="none" />
            <circle cx="-8" cy="-10" r="1" fill="currentColor" stroke="none" />
            <circle cx="18" cy="2" r="0.8" fill="currentColor" stroke="none" />
            <circle cx="-16" cy="0" r="0.9" fill="currentColor" stroke="none" />
          </g>

          <line x1="60" y1="250" x2="420" y2="250" stroke-width="1.3" />
        </g>
      )}

      {name === 'internet' && (
        <g stroke="currentColor" fill="none">
          <ellipse cx="240" cy="140" rx="185" ry="95" stroke-width="0.6" opacity="0.5" />
          <g stroke-width="0.7" opacity="0.85">
            <line x1="120" y1="90" x2="200" y2="70" /><line x1="200" y1="70" x2="290" y2="80" />
            <line x1="290" y1="80" x2="360" y2="60" /><line x1="120" y1="90" x2="150" y2="150" />
            <line x1="150" y1="150" x2="200" y2="70" /><line x1="150" y1="150" x2="230" y2="180" />
            <line x1="230" y1="180" x2="290" y2="80" /><line x1="230" y1="180" x2="330" y2="200" />
            <line x1="330" y1="200" x2="360" y2="60" /><line x1="360" y1="60" x2="410" y2="130" />
            <line x1="330" y1="200" x2="410" y2="130" /><line x1="90" y1="170" x2="150" y2="150" />
            <line x1="90" y1="170" x2="230" y2="180" /><line x1="200" y1="70" x2="120" y2="90" />
          </g>
          <g fill="currentColor" stroke="none">
            <circle cx="120" cy="90" r="4" /><circle cx="200" cy="70" r="3.5" />
            <circle cx="290" cy="80" r="3.5" /><circle cx="360" cy="60" r="4.5" />
            <circle cx="150" cy="150" r="3" /><circle cx="230" cy="180" r="4" />
            <circle cx="330" cy="200" r="3.5" /><circle cx="410" cy="130" r="4" />
            <circle cx="90" cy="170" r="3" />
          </g>
        </g>
      )}
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .engraving { margin: 0 0 var(--space-l); text-align: center; }
  .engraving-frame {
    display: inline-block;
    padding: 0.6rem;
    background: var(--paper);
  }
  .engraving-frame svg {
    display: block;
    width: min(100%, 28rem);
    height: auto;
    color: var(--ink);
  }
  figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-faint);
    font-size: var(--step--1);
  }
</style>
