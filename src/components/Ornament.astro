---
// Print-native engraved ornaments — line-art, not icons, not photography.
// Each reads as a small decorative block a hand-set paper might have cut.
const { name, size = 44, class: className = '' } = Astro.props;
---
<span class={`ornament ${className}`} style={`--o-size:${size}px`} aria-hidden="true">
  {name === 'progress' && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 34 L19 24 L27 29 L41 13" />
      <path d="M41 13 L33 13 M41 13 L41 21" />
      <path class="accent" d="M7 40 L41 40" stroke-width="1" opacity="0.5" />
      <circle cx="19" cy="24" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="27" cy="29" r="1.6" fill="currentColor" stroke="none" />
    </svg>
  )}
  {name === 'compass' && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
      <circle cx="24" cy="24" r="17" />
      <circle cx="24" cy="24" r="12.5" opacity="0.4" />
      <path class="accent" d="M24 9 L28 24 L24 39 L20 24 Z" fill="currentColor" stroke="none" opacity="0.9" />
      <path d="M9 24 L24 20 L39 24 L24 28 Z" fill="none" />
      <circle cx="24" cy="24" r="1.6" fill="currentColor" stroke="none" />
    </svg>
  )}
  {name === 'lamp' && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 30 C9 25 15 22 23 22 C31 22 39 24 39 28 C39 31 34 33 27 33 L15 33 C11 33 9 32 9 30 Z" />
      <path d="M39 27 C42 26 43 24 42 22" />
      <path d="M15 22 L14 17 L20 17" />
      <path class="accent" d="M17 17 C17 13 15 12 16 9 C18 11 20 12 19 16" />
    </svg>
  )}
  {name === 'fork' && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 41 L24 27" />
      <path d="M24 27 C24 20 14 18 10 9" />
      <path class="accent" d="M24 27 C24 20 34 18 38 9" opacity="0.85" />
      <circle cx="24" cy="27" r="1.8" fill="currentColor" stroke="none" />
      <circle cx="10" cy="9" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="38" cy="9" r="1.6" fill="var(--oxide)" stroke="none" />
    </svg>
  )}
  {name === 'knot' && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
      <path d="M24 8 L38 16 L38 32 L24 40 L10 32 L10 16 Z" />
      <path class="accent" d="M24 16 L31 20 L31 28 L24 32 L17 28 L17 20 Z" opacity="0.55" />
      <path d="M10 16 L24 24 L38 16 M24 24 L24 40 M10 32 L24 24 L38 32" opacity="0.75" />
    </svg>
  )}
</span>

<style>
  .ornament {
    display: inline-flex;
    width: var(--o-size);
    height: var(--o-size);
    color: var(--ink);
  }
  .ornament svg { width: 100%; height: 100%; display: block; }
  .ornament .accent { color: var(--oxide); stroke: var(--oxide); }
</style>
