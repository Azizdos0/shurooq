---
import SunVignette from './SunVignette.astro';
const {
  issue = 'العدد الأول',
  status = 'قريبًا',
  tagline = 'أن نرى العالمَ بعينٍ جديدة',
} = Astro.props;
---
<header class="masthead">
  <div class="container">
    <hr class="rule-double" />
    <div class="nameplate">
      <div class="meta meta-start">
        <span class="meta-label">{issue}</span>
        <span class="meta-value">{status}</span>
      </div>

      <h1 class="wordmark">شروق</h1>

      <div class="meta meta-end">
        <span class="meta-label">صحيفةٌ دورية</span>
        <span class="meta-value">تأسست ٢٠٢٦</span>
      </div>
    </div>
    <p class="tagline">{tagline}</p>

    <div class="horizon-wrap">
      <SunVignette />
    </div>
  </div>
</header>

<style>
  .masthead { padding-top: var(--space-m); }
  .rule-double { margin-bottom: var(--space-m); }

  .nameplate {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
  }

  .wordmark {
    font-family: var(--font-wordmark);
    font-size: var(--step-4);
    font-weight: 400;
    line-height: 0.9;
    text-align: center;
    color: var(--ink);
    animation: word-in 1s var(--ease) both;
  }
  @keyframes word-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-display);
    line-height: 1.3;
  }
  .meta-start { align-items: flex-start; }
  .meta-end   { align-items: flex-end; text-align: end; }
  .meta-label { color: var(--oxide); font-size: var(--step--1); }
  .meta-value { color: var(--ink-soft); font-size: var(--step-0); }

  .tagline {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }

  .horizon-wrap { margin-top: var(--space-s); }

  @media (max-width: 40rem) {
    .nameplate { grid-template-columns: 1fr; justify-items: center; gap: var(--space-xs); }
    .meta { flex-direction: row; gap: 0.5rem; align-items: baseline; }
    .meta-start, .meta-end { text-align: center; }
    .meta-end { order: 3; }
  }
</style>
