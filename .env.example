# Shurooq editor — Supabase connection (server-side only, never exposed to the browser)
# Copy this file to `.env` and fill in the values.
#
# Where to find these: Supabase dashboard → your `shurooq` project →
#   Project Settings → API
#   - SUPABASE_URL              = "Project URL"
#   - SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key (NOT the anon key)
#
# The service_role key bypasses Row Level Security, so it must stay secret.
# `.env` is git-ignored; do not commit it.

SUPABASE_URL=https://gtaloecazaqefmecvzav.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service_role-key-here
